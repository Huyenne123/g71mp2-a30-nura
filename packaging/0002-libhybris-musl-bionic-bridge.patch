+static inline int _pthread_cond_clockwait_compat(pthread_cond_t *cond, pthread_mutex_t *mutex, clockid_t clock_id, const struct timespec *abstime) {
+    if (clock_id == CLOCK_REALTIME) {
+        return pthread_cond_timedwait(cond, mutex, abstime);
+    }
+    struct timespec now, rel, ts_real;
+    clock_gettime(clock_id, &now);
+    if (abstime->tv_sec < now.tv_sec || (abstime->tv_sec == now.tv_sec && abstime->tv_nsec <= now.tv_nsec))
+        return ETIMEDOUT;
+    rel.tv_sec = abstime->tv_sec - now.tv_sec;
+    rel.tv_nsec = abstime->tv_nsec - now.tv_nsec;
+    if (rel.tv_nsec < 0) { rel.tv_sec--; rel.tv_nsec += 1000000000L; }
+    clock_gettime(CLOCK_REALTIME, &ts_real);
+    ts_real.tv_sec += rel.tv_sec;
+    ts_real.tv_nsec += rel.tv_nsec;
+    if (ts_real.tv_nsec >= 1000000000L) { ts_real.tv_sec++; ts_real.tv_nsec -= 1000000000L; }
+    return pthread_cond_timedwait(cond, mutex, &ts_real);
+}
+#define pthread_cond_clockwait _pthread_cond_clockwait_compat
