+static inline int _scandirat_compat(int dirfd, const char *dir, struct dirent ***namelist,
+                                    int (*filter)(const struct dirent *),
+                                    int (*compare)(const struct dirent **, const struct dirent **))
+{
+    int dfd = openat(dirfd, dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (dfd < 0) return -1;
+    DIR *d = fdopendir(dfd);
+    if (!d) {
+        close(dfd);
+        return -1;
+    }
+    struct dirent **names = NULL;
+    size_t count = 0, capacity = 0;
+    struct dirent *de;
+    while ((de = readdir(d)) != NULL) {
+        if (filter && !filter(de)) continue;
+        if (count >= capacity) {
+            size_t new_cap = capacity ? capacity * 2 : 16;
+            struct dirent **new_names = (struct dirent **)realloc(names, new_cap * sizeof(struct dirent *));
+            if (!new_names) {
+                while (count > 0) free(names[--count]);
+                free(names);
+                closedir(d);
+                return -1;
+            }
+            names = new_names;
+            capacity = new_cap;
+        }
+        size_t dsize = sizeof(struct dirent) + strlen(de->d_name) + 1;
+        struct dirent *copy = (struct dirent *)malloc(dsize);
+        if (!copy) {
+            while (count > 0) free(names[--count]);
+            free(names);
+            closedir(d);
+            return -1;
+        }
+        memcpy(copy, de, sizeof(struct dirent));
+        names[count++] = copy;
+    }
+    closedir(d);
+    if (compare && count > 1) {
+        qsort(names, count, sizeof(struct dirent *), (int (*)(const void *, const void *))compare);
+    }
+    *namelist = names;
+    return count;
+}
