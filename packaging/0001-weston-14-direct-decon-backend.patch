+static int
+decon_backend_output_configure(struct weston_output *output)
+{
+	struct wet_compositor *wet = to_wet_compositor(output->compositor);
+	struct weston_config *wc = wet->config;
+	struct weston_config_section *section;
+
+	section = weston_config_get_section(wc, "output", "name", output->name);
+
+	wet_output_set_scale(output, section, 1, 0);
+	wet_output_set_transform(output, section, WL_OUTPUT_TRANSFORM_NORMAL, UINT32_MAX);
+
+	if (wet_output_set_eotf_mode(output, section, wet->use_color_manager) < 0)
+		return -1;
+	if (wet_output_set_colorimetry_mode(output, section, wet->use_color_manager) < 0)
+		return -1;
+	if (wet_output_set_color_characteristics(output, wc, section) < 0)
+		return -1;
+
+	return 0;
+}
+
+static int
+load_decon_backend(struct weston_compositor *c, int *argc, char **argv,
+		   struct weston_config *wc, enum weston_renderer_type renderer)
+{
+	struct weston_decon_backend_config config = {{ 0, }};
+	struct weston_config_section *section;
+	struct wet_backend *wb;
+	bool force_pixman = false;
+
+	config.base.struct_version = WESTON_DECON_BACKEND_CONFIG_VERSION;
+	config.base.struct_size = sizeof(struct weston_decon_backend_config);
+	config.width = 1080;
+	config.height = 2340;
+	config.refresh_mhz = 60000;
+	config.window_index = 3;
+	config.fb_dev = "/dev/graphics/fb0";
+	config.ion_dev = "/dev/ion";
+	config.renderer_type = WESTON_RENDERER_PIXMAN;
+
+	section = weston_config_get_section(wc, "core", NULL, NULL);
+	weston_config_section_get_bool(section, "use-pixman", &force_pixman, false);
+
+	const struct weston_option options[] = {
+		{ WESTON_OPTION_INTEGER, "width", 0, &config.width },
+		{ WESTON_OPTION_INTEGER, "height", 0, &config.height },
+		{ WESTON_OPTION_BOOLEAN, "use-pixman", 0, &force_pixman },
+		{ WESTON_OPTION_INTEGER, "window-index", 0, &config.window_index },
+		{ WESTON_OPTION_BOOLEAN, "mock", 0, &config.mock_mode },
+	};
+	parse_options(options, ARRAY_LENGTH(options), argc, argv);
+
+	if (force_pixman || renderer == WESTON_RENDERER_PIXMAN || renderer == WESTON_RENDERER_AUTO)
+		config.renderer_type = WESTON_RENDERER_PIXMAN;
+	else
+		config.renderer_type = renderer;
+
+	wb = wet_compositor_load_backend(c, WESTON_BACKEND_DECON,
+					 &config.base, simple_heads_changed,
+					 decon_backend_output_configure);
+	if (!wb)
+		return -1;
+
+	return 0;
+}
