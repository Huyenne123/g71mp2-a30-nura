+ * NONINFRINGEMENT.  IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS
+ * BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN
+ * ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+ * CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ * SOFTWARE.
+ */
+
+#include "decon_internal.h"
+#include <shared/timespec-util.h>
+
+static const uint32_t decon_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_RGBA8888,
+	DRM_FORMAT_RGBX8888,
+};
+
+static void
+decon_output_destroy(struct weston_output *base);
+
+static int
+decon_output_disable(struct weston_output *base);
+
+static void
+decon_backend_destroy(struct weston_backend *backend);
+
+/* -------------------------------------------------------------------------
+ * Presentation & Retire Fence Synchronization Loop
+ * ------------------------------------------------------------------------- */
+
+static struct timespec g_t_last_fence = { 0, 0 };
+static double g_last_render_ms = 0.0;
+static double g_last_present_ms = 0.0;
+
+static int
+decon_fence_handler(int fd, uint32_t mask, void *data)
+{
+	struct decon_output *output = data;
+	struct timespec ts, t_now;
+	uint32_t flags = WP_PRESENTATION_FEEDBACK_KIND_VSYNC;
+
+	(void)fd;
+
+	if (mask & (WL_EVENT_ERROR | WL_EVENT_HANGUP)) {
+		weston_log("[-] decon: Retire fence error or hangup on fd %d (mask 0x%x)\n",
+			   output->current_retire_fence, mask);
+		flags = WP_PRESENTATION_FEEDBACK_INVALID;
+	}
+
+	if (output->fence_source) {
+		wl_event_source_remove(output->fence_source);
+		output->fence_source = NULL;
+	}
+
+	if (output->current_retire_fence >= 0) {
+		close(output->current_retire_fence);
+		output->current_retire_fence = -1;
+	}
+
+	clock_gettime(CLOCK_MONOTONIC, &t_now);
+	double fence_interval_ms = 0.0;
+	if (g_t_last_fence.tv_sec > 0) {
+		fence_interval_ms = (t_now.tv_sec - g_t_last_fence.tv_sec) * 1000.0 +
+				    (t_now.tv_nsec - g_t_last_fence.tv_nsec) / 1000000.0;
+	}
+	g_t_last_fence = t_now;
+
+	weston_compositor_read_presentation_clock(output->base.compositor, &ts);
+	weston_output_finish_frame(&output->base, &ts, flags);
+
+	static uint32_t fence_count = 0;
+	fence_count++;
+	if (fence_count <= 5 || fence_count % 60 == 0) {
+		weston_log("[+] decon: Retire fence #%u signaled (interval: %.2f ms, render: %.2f ms, present: %.2f ms, flags 0x%x)\n",
+			   fence_count, fence_interval_ms, g_last_render_ms, g_last_present_ms, flags);
+	}
+
+	/* Toggle ping-pong active buffer index */
+	output->active_idx ^= 1;
+	if (output->engine)
+		output->engine->active_idx = output->active_idx;
+
+	return 0;
+}
+
+static int
+finish_frame_timer_handler(void *data)
+{
+	struct decon_output *output = data;
+	struct timespec ts;
+
+	weston_compositor_read_presentation_clock(output->base.compositor, &ts);
+	weston_output_finish_frame(&output->base, &ts, WP_PRESENTATION_FEEDBACK_INVALID);
+
+	output->active_idx ^= 1;
+	if (output->engine)
+		output->engine->active_idx = output->active_idx;
+
+	return 0;
+}
+
+static int
+decon_output_start_repaint_loop(struct weston_output *base)
+{
+	struct timespec ts;
+
+	weston_compositor_read_presentation_clock(base->compositor, &ts);
+	weston_output_finish_frame(base, &ts, WP_PRESENTATION_FEEDBACK_INVALID);
+
+	return 0;
+}
+
+static int
+decon_output_repaint(struct weston_output *base)
+{
+	struct decon_output *output = to_decon_output(base);
+	struct weston_compositor *ec;
+	pixman_region32_t damage;
+	int retire_fence = -1;
+
+	assert(output);
+	ec = output->base.compositor;
+
+	pixman_region32_init(&damage);
+	weston_output_flush_damage_for_primary_plane(base, &damage);
+
+	struct timespec t0, t1, t2;
+	clock_gettime(CLOCK_MONOTONIC, &t0);
+
+	/* Repaint into active swapchain renderbuffer */
+	ec->renderer->repaint_output(base, &damage,
+				     output->renderbuffers[output->active_idx]);
+	pixman_region32_fini(&damage);
+	clock_gettime(CLOCK_MONOTONIC, &t1);
+
+	/* Guard against any stale in-flight retire fence before new submission */
+	if (output->fence_source) {
+		weston_log("[-] decon: Stale retire fence detected during repaint, cleaning up\n");
+		wl_event_source_remove(output->fence_source);
+		output->fence_source = NULL;
+	}
+	if (output->current_retire_fence >= 0) {
+		close(output->current_retire_fence);
+		output->current_retire_fence = -1;
+	}
+
+	/* Present buffer to Samsung DECON Window 3 */
+	if (output->engine && !output->backend->config.mock_mode) {
+		int ret = decon_backend_present(output->engine, &retire_fence);
+		if (ret < 0) {
+			weston_log("[-] decon: S3CFB_WIN_CONFIG ioctl failed: %s\n",
+				   strerror(errno));
+			return -1;
+		}
+
+		clock_gettime(CLOCK_MONOTONIC, &t2);
+		g_last_render_ms = (t1.tv_sec - t0.tv_sec) * 1000.0 + (t1.tv_nsec - t0.tv_nsec) / 1000000.0;
+		g_last_present_ms = (t2.tv_sec - t1.tv_sec) * 1000.0 + (t2.tv_nsec - t1.tv_nsec) / 1000000.0;
+
+		static uint32_t repaint_count = 0;
+		repaint_count++;
+		if (repaint_count <= 5 || repaint_count % 60 == 0) {
+			weston_log("[+] decon: Hardware repaint #%u presented on buffer %u (fence fd %d, render: %.2f ms, present: %.2f ms)\n",
+				   repaint_count, output->active_idx, retire_fence, g_last_render_ms, g_last_present_ms);
+		}
+	}
+
+	/* Register retire fence on Wayland event loop */
+	if (retire_fence >= 0) {
+		struct wl_event_loop *loop =
+			wl_display_get_event_loop(ec->wl_display);
+
+		output->current_retire_fence = retire_fence;
+		output->fence_source = wl_event_loop_add_fd(
+			loop,
+			retire_fence,
+			WL_EVENT_READABLE,
+			decon_fence_handler,
+			output
+		);
+
+		if (!output->fence_source) {
+			weston_log("[-] decon: Failed to attach retire fence to event loop\n");
+			close(retire_fence);
+			output->current_retire_fence = -1;
+			wl_event_source_timer_update(output->finish_frame_timer, 16);
+		}
+	} else {
+		/* Fallback software timer for mock mode or software scanout */
+		int delay_msec = millihz_to_nsec(output->mode.refresh) / 1000000;
+		if (delay_msec < 1)
+			delay_msec = 16;
+		wl_event_source_timer_update(output->finish_frame_timer, delay_msec);
+	}
+
+	return 0;
+}
+
+/* -------------------------------------------------------------------------
+ * Output Lifecycle Operations
+ * ------------------------------------------------------------------------- */
+
+static int
+decon_output_enable(struct weston_output *base)
+{
+	struct decon_output *output = to_decon_output(base);
+	struct weston_decon_backend *b;
+	struct wl_event_loop *loop;
+	struct weston_head *head;
+
+	assert(output);
+	b = output->backend;
+
+	if (output->base.enabled)
+		return 0;
+
+	output->base.start_repaint_loop = decon_output_start_repaint_loop;
+	output->base.repaint = decon_output_repaint;
+
+	loop = wl_display_get_event_loop(b->compositor->wl_display);
+	output->finish_frame_timer =
+		wl_event_loop_add_timer(loop, finish_frame_timer_handler, output);
+	if (!output->finish_frame_timer) {
+		weston_log("[-] decon: Failed to register finish frame timer\n");
+		return -1;
+	}
+
+	/* Initialize underlying hardware DECON engine and ION swapchain */
+	if (!b->config.mock_mode) {
+		struct decon_backend_config eng_cfg;
+		memset(&eng_cfg, 0, sizeof(eng_cfg));
+		eng_cfg.width = b->config.width;
+		eng_cfg.height = b->config.height;
+		eng_cfg.stride = b->config.width * 4;
+		eng_cfg.buffer_size = b->config.width * b->config.height * 4;
+		eng_cfg.window_index = b->config.window_index;
+		eng_cfg.fb_node = b->config.fb_dev;
+		eng_cfg.ion_node = b->config.ion_dev;
+
+		if (!output->engine) {
+			output->engine = decon_backend_init(&eng_cfg);
+			if (!output->engine) {
+				weston_log("[-] decon: Failed to open %s and %s\n",
+					   b->config.fb_dev, b->config.ion_dev);
+				wl_event_source_remove(output->finish_frame_timer);
+				output->finish_frame_timer = NULL;
+				return -1;
+			}
+		}
+
+		if (!output->engine->buffers[0].cpu_mmap_ptr) {
+			int ret = decon_backend_setup_swapchain_ion(output->engine, 1 /* map_cpu */);
+			if (ret < 0) {
+				weston_log("[-] decon: Failed to allocate ION swapchain (err %d)\n", ret);
+				decon_backend_teardown(output->engine);
+				output->engine = NULL;
+				wl_event_source_remove(output->finish_frame_timer);
+				output->finish_frame_timer = NULL;
+				return -1;
+			}
+		}
+	}
+
+	/* Create Pixman renderbuffers */
+	if (b->compositor->renderer->type == WESTON_RENDERER_PIXMAN) {
+		const struct pixman_renderer_output_options options = {
+			.use_shadow = false,
+			.fb_size = {
+				.width = output->mode.width,
+				.height = output->mode.height
+			},
+			.format = pixel_format_get_info(DRM_FORMAT_XRGB8888)
+		};
+
+		const struct pixman_renderer_interface *pixman =
+			b->compositor->renderer->pixman;
+
+		if (pixman->output_create(&output->base, &options) < 0) {
+			weston_log("[-] decon: Failed to initialize pixman output state\n");
+			if (output->engine) {
+				decon_backend_teardown(output->engine);
+				output->engine = NULL;
+			}
+			wl_event_source_remove(output->finish_frame_timer);
+			output->finish_frame_timer = NULL;
+			return -1;
+		}
+
+		for (int i = 0; i < 2; i++) {
+			void *map_ptr = output->engine ?
+				output->engine->buffers[i].cpu_mmap_ptr : NULL;
+
+			if (map_ptr) {
+				output->renderbuffers[i] = pixman->create_image_from_ptr(
+					&output->base,
+					options.format,
+					output->mode.width,
+					output->mode.height,
+					map_ptr,
+					output->mode.width * 4
+				);
+			} else {
+				output->renderbuffers[i] = pixman->create_image(
+					&output->base,
+					options.format,
+					output->mode.width,
+					output->mode.height
+				);
+			}
+
+			if (!output->renderbuffers[i]) {
+				weston_log("[-] decon: Failed to create renderbuffer %d\n", i);
+				decon_output_disable(&output->base);
+				return -1;
+			}
+		}
+	}
+
+	wl_list_for_each(head, &output->base.head_list, output_link) {
+		weston_head_set_monitor_strings(head, "Samsung", "EA8076 Super AMOLED", "DECON-0");
+		weston_head_set_physical_size(head, 68, 147);
+	}
+
+	output->active_idx = 0;
+	output->current_retire_fence = -1;
+	return 0;
+}
+
+static int
+decon_output_disable(struct weston_output *base)
+{
+	struct decon_output *output = to_decon_output(base);
+	struct weston_compositor *ec;
+
+	assert(output);
+
+	if (!output->base.enabled)
+		return 0;
+
+	ec = output->base.compositor;
+
+	if (output->fence_source) {
+		wl_event_source_remove(output->fence_source);
+		output->fence_source = NULL;
+	}
+
+	if (output->current_retire_fence >= 0) {
+		close(output->current_retire_fence);
+		output->current_retire_fence = -1;
+	}
+
+	if (output->finish_frame_timer) {
+		wl_event_source_remove(output->finish_frame_timer);
+		output->finish_frame_timer = NULL;
+	}
+
+	for (int i = 0; i < 2; i++) {
+		if (output->renderbuffers[i]) {
+			weston_renderbuffer_unref(output->renderbuffers[i]);
+			output->renderbuffers[i] = NULL;
+		}
+	}
+
+	if (ec->renderer && ec->renderer->pixman)
+		ec->renderer->pixman->output_destroy(&output->base);
+
+	if (output->engine) {
+		decon_backend_teardown(output->engine);
+		output->engine = NULL;
+	}
+
+	return 0;
+}
+
+static void
+decon_output_destroy(struct weston_output *base)
+{
+	struct decon_output *output = to_decon_output(base);
+
+	assert(output);
+
+	decon_output_disable(&output->base);
+	weston_output_release(&output->base);
+	free(output);
+}
+
+static int
+decon_output_attach_head(struct weston_output *output_base,
+			 struct weston_head *head)
+{
+	(void)output_base;
+	(void)head;
+	return 0;
+}
+
+static struct weston_output *
+decon_output_create(struct weston_backend *backend, const char *name)
+{
+	struct weston_decon_backend *b = to_weston_decon_backend(backend);
+	struct weston_compositor *compositor = b->compositor;
+	struct decon_output *output;
+
+	assert(name);
+
+	output = zalloc(sizeof *output);
+	if (!output)
+		return NULL;
+
+	weston_output_init(&output->base, compositor, name);
+
+	output->base.destroy = decon_output_destroy;
+	output->base.disable = decon_output_disable;
+	output->base.enable = decon_output_enable;
+	output->base.attach_head = decon_output_attach_head;
+
+	output->backend = b;
+	output->current_retire_fence = -1;
+
+	/* Initialize fixed AMOLED display mode (1080x2340@60Hz) */
+	output->mode.flags = WL_OUTPUT_MODE_CURRENT | WL_OUTPUT_MODE_PREFERRED;
+	output->mode.width = b->config.width;
+	output->mode.height = b->config.height;
+	output->mode.refresh = b->config.refresh_mhz;
+	wl_list_insert(&output->base.mode_list, &output->mode.link);
+
+	output->base.native_scale = 1;
+	output->base.current_scale = 1;
+	output->base.original_scale = 1;
+	output->base.current_mode = &output->mode;
+	output->base.native_mode = &output->mode;
+	output->base.original_mode = &output->mode;
+
+	weston_compositor_add_pending_output(&output->base, compositor);
+
+	return &output->base;
+}
+
+/* -------------------------------------------------------------------------
+ * Head & Monitor Registration
+ * ------------------------------------------------------------------------- */
+
+static int
+decon_head_create(struct weston_decon_backend *backend, const char *name)
+{
+	struct decon_head *head;
+
+	assert(name);
+
+	head = zalloc(sizeof *head);
+	if (!head)
+		return -1;
+
+	weston_head_init(&head->base, name);
+	head->base.backend = &backend->base;
+	head->backend = backend;
+
+	weston_head_set_connection_status(&head->base, true);
+	weston_head_set_internal(&head->base);
+	weston_head_set_monitor_strings(&head->base, "Samsung", "EA8076 Super AMOLED", "DECON-0");
+	weston_head_set_physical_size(&head->base, 68, 147);
+	weston_head_set_subpixel(&head->base, WL_OUTPUT_SUBPIXEL_NONE);
+
+	weston_compositor_add_head(backend->compositor, &head->base);
+	backend->head = head;
+
+	return 0;
+}
+
+static void
+decon_head_destroy(struct weston_head *base)
+{
+	struct decon_head *head = to_decon_head(base);
+
+	assert(head);
+
+	weston_head_release(&head->base);
+	free(head);
+}
+
+/* -------------------------------------------------------------------------
+ * Backend Module Lifecycle
+ * ------------------------------------------------------------------------- */
+
+static void
+decon_backend_destroy(struct weston_backend *backend)
+{
+	struct weston_decon_backend *b = to_weston_decon_backend(backend);
+	struct weston_compositor *ec = b->compositor;
+	struct weston_head *base, *next;
+
+	wl_list_remove(&b->base.link);
+
+	wl_list_for_each_safe(base, next, &ec->head_list, compositor_link) {
+		if (base->backend == &b->base)
+			decon_head_destroy(base);
+	}
+
+#ifdef BUILD_DECON_INPUT
+	if (b->udev) {
+		udev_input_destroy(&b->input);
+		udev_unref(b->udev);
+		b->udev = NULL;
+	}
+#endif
+
+	if (b->formats) {
+		free(b->formats);
+		b->formats = NULL;
+	}
+
+	free(b);
+}
+
+#ifdef BUILD_DECON_INPUT
+#include <fcntl.h>
+/* Direct embedded device opener when running without a session launcher / seatd */
+WL_EXPORT int
+weston_launcher_open(struct weston_launcher *launcher,
+		     const char *path, int flags)
+{
+	(void)launcher;
+	return open(path, flags);
+}
+
+WL_EXPORT void
+weston_launcher_close(struct weston_launcher *launcher, int fd)
+{
+	(void)launcher;
+	close(fd);
+}
+#endif
+
+static struct weston_decon_backend *
+decon_backend_create(struct weston_compositor *compositor,
+		     struct weston_decon_backend_config *config)
+{
+	struct weston_decon_backend *b;
+	int ret;
+
+	b = zalloc(sizeof *b);
+	if (!b)
+		return NULL;
+
+	b->compositor = compositor;
+	memcpy(&b->config, config, sizeof(*config));
+	wl_list_insert(&compositor->backend_list, &b->base.link);
+
+	b->base.supported_presentation_clocks =
+		WESTON_PRESENTATION_CLOCKS_SOFTWARE | (1 << CLOCK_MONOTONIC);
+	b->base.destroy = decon_backend_destroy;
+	b->base.create_output = decon_output_create;
+
+	b->formats_count = ARRAY_LENGTH(decon_formats);
+	b->formats = pixel_format_get_array(decon_formats, b->formats_count);
+
+	/* Initialize compositor renderer if not already active */
+	if (!compositor->renderer) {
+		switch (config->renderer_type) {
+		case WESTON_RENDERER_PIXMAN:
+		case WESTON_RENDERER_AUTO:
+			ret = weston_compositor_init_renderer(compositor,
+							      WESTON_RENDERER_PIXMAN,
+							      NULL);
+			break;
+		case WESTON_RENDERER_GL:
+			weston_log("[-] decon: GL renderer requested. Note: proprietary GLES requires Bionic/libhybris.\n");
+			ret = weston_compositor_init_renderer(compositor,
+							      WESTON_RENDERER_GL,
+							      NULL);
+			break;
+		case WESTON_RENDERER_NOOP:
+			ret = noop_renderer_init(compositor);
+			break;
+		default:
+			weston_log("[-] decon: Unsupported renderer type %d\n",
+				   config->renderer_type);
+			ret = -1;
+			break;
+		}
+
+		if (ret < 0) {
+			weston_log("[-] decon: Failed to initialize renderer\n");
+			goto err_free;
+		}
+	}
+
+#ifdef BUILD_DECON_INPUT
+	b->udev = udev_new();
+	if (b->udev) {
+		if (udev_input_init(&b->input, compositor, b->udev,
+				    "seat0", NULL) < 0) {
+			weston_log("[-] decon: Failed to initialize udev input on seat0\n");
+		} else {
+			weston_log("[+] decon: Udev input successfully initialized on seat0\n");
+		}
+	} else {
+		weston_log("[-] decon: Failed to create udev context\n");
+	}
+#endif
+
+	/* Register primary display head */
+	if (decon_head_create(b, DECON_DEFAULT_OUTPUT_NAME) < 0) {
+		weston_log("[-] decon: Failed to register display head\n");
+		goto err_free;
+	}
+
+	return b;
+
+err_free:
+	if (b->formats)
+		free(b->formats);
+	wl_list_remove(&b->base.link);
+	free(b);
+	return NULL;
+}
+
+static void
+config_init_to_defaults(struct weston_decon_backend_config *config)
+{
+	config->renderer_type = WESTON_RENDERER_PIXMAN;
+	config->fb_dev = "/dev/graphics/fb0";
+	config->ion_dev = "/dev/ion";
+	config->width = DECON_DEFAULT_WIDTH;
+	config->height = DECON_DEFAULT_HEIGHT;
+	config->refresh_mhz = DECON_DEFAULT_REFRESH_MHZ;
+	config->window_index = DECON_PRIMARY_WINDOW;
+	config->mock_mode = false;
+}
+
+WL_EXPORT int
+weston_backend_init(struct weston_compositor *compositor,
+		    struct weston_backend_config *config_base)
+{
+	struct weston_decon_backend *b;
+	struct weston_decon_backend_config config;
+
+	memset(&config, 0, sizeof(config));
+	config_init_to_defaults(&config);
+
+	if (config_base != NULL) {
+		if (config_base->struct_version != WESTON_DECON_BACKEND_CONFIG_VERSION ||
+		    config_base->struct_size > sizeof(struct weston_decon_backend_config)) {
+			weston_log("[-] decon: Backend config structure is invalid (version %u, size %zu)\n",
+				   config_base->struct_version, (size_t)config_base->struct_size);
+			return -1;
+		}
+		memcpy(&config, config_base, config_base->struct_size);
+	}
+
+	b = decon_backend_create(compositor, &config);
+	if (!b)
+		return -1;
+
+	return 0;
+}
diff --git a/libweston/backend-decon/decon_backend.c b/libweston/backend-decon/decon_backend.c
new file mode 100644
index 0000000..8c61b46
--- /dev/null
+++ b/libweston/backend-decon/decon_backend.c
@@ -0,0 +1,431 @@
+/*
+ * Direct-DECON Presentation Engine Implementation
+ * Target: Samsung Galaxy A30 (SM-A305F) / Exynos 7904 / Mali-G71 MP2
+ *
+ * Implements hardware-accelerated direct scanout on DECON Window 3.
+ */
+
+#include "decon_backend.h"
+
+/* Standard system calls and memory operations */
+extern void *malloc(size_t size);
+extern void free(void *ptr);
+extern void *memset(void *s, int c, size_t n);
+extern void *memcpy(void *dest, const void *src, size_t n);
+extern int open(const char *pathname, int flags, ...);
+extern int close(int fd);
+extern int ioctl(int fd, unsigned long request, ...);
+extern void *dlsym(void *handle, const char *symbol);
+extern int printf(const char *fmt, ...);
+extern void *mmap(void *addr, size_t length, int prot, int flags, int fd, long offset);
+extern int munmap(void *addr, size_t length);
+
+#define PROT_READ  0x1
+#define PROT_WRITE 0x2
+#define MAP_SHARED 0x01
+#define MAP_FAILED ((void *)-1)
+
+struct pollfd {
+    int   fd;
+    short events;
+    short revents;
+};
+#define POLLIN 0x0001
+extern int poll(struct pollfd *fds, unsigned long nfds, int timeout);
+
+/* EGL / DRM Definitions */
+#define EGL_DEFAULT_DISPLAY        ((void *)0)
+#define EGL_NONE                   0x3038
+#define EGL_SURFACE_TYPE           0x3033
+#define EGL_PBUFFER_BIT            0x0001
+#define EGL_RENDERABLE_TYPE        0x3040
+#define EGL_OPENGL_ES2_BIT         0x0004
+#define EGL_OPENGL_ES3_BIT         0x0040
+#define EGL_RED_SIZE               0x3024
+#define EGL_GREEN_SIZE             0x3023
+#define EGL_BLUE_SIZE              0x3022
+#define EGL_ALPHA_SIZE             0x3021
+#define EGL_WIDTH                  0x3057
+#define EGL_HEIGHT                 0x3056
+#define EGL_CONTEXT_CLIENT_VERSION 0x3098
+#define EGL_NO_CONTEXT             ((void *)0)
+#define EGL_LINUX_DMA_BUF_EXT      0x3270
+#define EGL_LINUX_DRM_FOURCC_EXT   0x3271
+#define EGL_DMA_BUF_PLANE0_FD_EXT     0x3272
+#define EGL_DMA_BUF_PLANE0_OFFSET_EXT 0x3273
+#define EGL_DMA_BUF_PLANE0_PITCH_EXT  0x3274
+#define DRM_FORMAT_ABGR8888        0x34324241
+
+/* GL Definitions */
+#define GL_FRAMEBUFFER             0x8D40
+#define GL_COLOR_ATTACHMENT0       0x8CE0
+#define GL_TEXTURE_2D              0x0DE1
+#define GL_TEXTURE_MIN_FILTER      0x2801
+#define GL_TEXTURE_MAG_FILTER      0x2800
+#define GL_LINEAR                  0x2601
+#define GL_FRAMEBUFFER_COMPLETE    0x8CD5
+#define GL_COLOR_BUFFER_BIT        0x00004000
+
+/* -------------------------------------------------------------------------
+ * Backend Lifecycle Implementation
+ * ------------------------------------------------------------------------- */
+
+struct decon_backend *decon_backend_init(const struct decon_backend_config *cfg)
+{
+    struct decon_backend *b = (struct decon_backend *)malloc(sizeof(struct decon_backend));
+    if (!b) return NULL;
+    memset(b, 0, sizeof(struct decon_backend));
+
+    /* Apply default configuration */
+    b->config.width = cfg && cfg->width ? cfg->width : DECON_DEFAULT_WIDTH;
+    b->config.height = cfg && cfg->height ? cfg->height : DECON_DEFAULT_HEIGHT;
+    b->config.stride = cfg && cfg->stride ? cfg->stride : DECON_DEFAULT_STRIDE;
+    b->config.buffer_size = cfg && cfg->buffer_size ? cfg->buffer_size : DECON_DEFAULT_BUFFER_SIZE;
+    b->config.window_index = cfg && cfg->window_index ? cfg->window_index : DECON_PRIMARY_WINDOW;
+    b->config.fb_node = cfg && cfg->fb_node ? cfg->fb_node : "/dev/graphics/fb0";
+    b->config.ion_node = cfg && cfg->ion_node ? cfg->ion_node : "/dev/ion";
+    b->config.mali_node = cfg && cfg->mali_node ? cfg->mali_node : "/dev/mali0";
+
+    /* Open display framebuffer (with /dev/null fallback for host mock testing) */
+    b->fb_fd = open(b->config.fb_node, 2 /* O_RDWR */);
+    if (b->fb_fd < 0) {
+        b->fb_fd = open("/dev/null", 2 /* O_RDWR */);
+        if (b->fb_fd < 0) {
+            printf("[-] decon_backend: Failed to open %s\n", b->config.fb_node);
+            free(b);
+            return NULL;
+        }
+    }
+
+    /* Open ION memory manager (with /dev/null fallback for host mock testing) */
+    b->ion_fd = open(b->config.ion_node, 2 /* O_RDWR */);
+    if (b->ion_fd < 0) {
+        b->ion_fd = open("/dev/null", 2 /* O_RDWR */);
+        if (b->ion_fd < 0) {
+            printf("[-] decon_backend: Failed to open %s\n", b->config.ion_node);
+            close(b->fb_fd);
+            free(b);
+            return NULL;
+        }
+    }
+
+    b->last_retire_fence = -1;
+    b->buffers[0].dma_buf_fd = -1;
+    b->buffers[1].dma_buf_fd = -1;
+    return b;
+}
+
+int decon_backend_setup_egl(struct decon_backend *b, void *dl_handle)
+{
+    if (!b || !dl_handle) return -1;
+    b->libgles_handle = dl_handle;
+
+    /* Resolve EGL symbols */
+    b->eglGetDisplay = (void *(*)(void*))dlsym(dl_handle, "eglGetDisplay");
+    b->eglInitialize = (uint32_t (*)(void*, int32_t*, int32_t*))dlsym(dl_handle, "eglInitialize");
+    b->eglChooseConfig = (uint32_t (*)(void*, const int32_t*, void**, int32_t, int32_t*))dlsym(dl_handle, "eglChooseConfig");
+    b->eglCreatePbufferSurface = (void *(*)(void*, void*, const int32_t*))dlsym(dl_handle, "eglCreatePbufferSurface");
+    b->eglCreateContext = (void *(*)(void*, void*, void*, const int32_t*))dlsym(dl_handle, "eglCreateContext");
+    b->eglMakeCurrent = (uint32_t (*)(void*, void*, void*, void*))dlsym(dl_handle, "eglMakeCurrent");
+    b->eglCreateImageKHR = (void *(*)(void*, void*, uint32_t, void*, const int32_t*))dlsym(dl_handle, "eglCreateImageKHR");
+    b->eglDestroyImageKHR = (uint32_t (*)(void*, void*))dlsym(dl_handle, "eglDestroyImageKHR");
+    b->eglDestroySurface = (uint32_t (*)(void*, void*))dlsym(dl_handle, "eglDestroySurface");
+    b->eglDestroyContext = (uint32_t (*)(void*, void*))dlsym(dl_handle, "eglDestroyContext");
+    b->eglTerminate = (uint32_t (*)(void*))dlsym(dl_handle, "eglTerminate");
+    b->eglGetError = (int32_t (*)(void))dlsym(dl_handle, "eglGetError");
+
+    /* Resolve GL symbols */
+    b->glGenTextures = (void (*)(int32_t, uint32_t*))dlsym(dl_handle, "glGenTextures");
+    b->glBindTexture = (void (*)(uint32_t, uint32_t))dlsym(dl_handle, "glBindTexture");
+    b->glTexParameteri = (void (*)(uint32_t, uint32_t, int32_t))dlsym(dl_handle, "glTexParameteri");
+    b->glGenFramebuffers = (void (*)(int32_t, uint32_t*))dlsym(dl_handle, "glGenFramebuffers");
+    b->glBindFramebuffer = (void (*)(uint32_t, uint32_t))dlsym(dl_handle, "glBindFramebuffer");
+    b->glFramebufferTexture2D = (void (*)(uint32_t, uint32_t, uint32_t, uint32_t, int32_t))dlsym(dl_handle, "glFramebufferTexture2D");
+    b->glCheckFramebufferStatus = (uint32_t (*)(uint32_t))dlsym(dl_handle, "glCheckFramebufferStatus");
+    b->glViewport = (void (*)(int32_t, int32_t, int32_t, int32_t))dlsym(dl_handle, "glViewport");
+    b->glClearColor = (void (*)(float, float, float, float))dlsym(dl_handle, "glClearColor");
+    b->glClear = (void (*)(uint32_t))dlsym(dl_handle, "glClear");
+    b->glFinish = (void (*)(void))dlsym(dl_handle, "glFinish");
+    b->glEGLImageTargetTexture2DOES = (void (*)(uint32_t, void*))dlsym(dl_handle, "glEGLImageTargetTexture2DOES");
+
+    /* 1. Connect EGL default display */
+    b->egl_display = b->eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (!b->egl_display) return -2;
+
+    int32_t major = 0, minor = 0;
+    if (!b->eglInitialize(b->egl_display, &major, &minor)) return -3;
+
+    /* 2. Choose Pbuffer GLES3 config */
+    int32_t config_attribs[] = {
+        EGL_SURFACE_TYPE,    EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT,
+        EGL_RED_SIZE,        8,
+        EGL_GREEN_SIZE,      8,
+        EGL_BLUE_SIZE,       8,
+        EGL_ALPHA_SIZE,      8,
+        EGL_NONE
+    };
+    void *config = NULL;
+    int32_t num_configs = 0;
+    if (!b->eglChooseConfig(b->egl_display, config_attribs, &config, 1, &num_configs) || num_configs < 1) {
+        return -4;
+    }
+
+    /* 3. Create dummy Pbuffer for EGL current surface */
+    int32_t pbuf_attribs[] = {
+        EGL_WIDTH, 64, EGL_HEIGHT, 64, EGL_NONE
+    };
+    b->egl_surface = b->eglCreatePbufferSurface(b->egl_display, config, pbuf_attribs);
+    if (!b->egl_surface) return -5;
+
+    /* 4. Create GLES 3 Context */
+    int32_t ctx_attribs[] = {
+        EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE
+    };
+    b->egl_context = b->eglCreateContext(b->egl_display, config, EGL_NO_CONTEXT, ctx_attribs);
+    if (!b->egl_context) return -6;
+
+    if (!b->eglMakeCurrent(b->egl_display, b->egl_surface, b->egl_surface, b->egl_context)) {
+        return -7;
+    }
+
+    return 0;
+}
+
+static int do_ioctl(struct decon_backend *b, int fd, unsigned long request, void *arg)
+{
+    if (b && b->ioctl_fn) {
+        return b->ioctl_fn(fd, request, arg);
+    }
+    return ioctl(fd, request, arg);
+}
+
+int decon_backend_setup_swapchain_ion(struct decon_backend *b, int map_cpu)
+{
+    if (!b) return -1;
+
+    for (int i = 0; i < 2; i++) {
+        struct decon_swapchain_buffer *buf = &b->buffers[i];
+
+        /* 1. Allocate ION physical buffer */
+        struct ion_allocation_data alloc_data;
+        memset(&alloc_data, 0, sizeof(alloc_data));
+        alloc_data.len = b->config.buffer_size;
+        alloc_data.align = 4096;
+        alloc_data.heap_id_mask = 1; /* ion_noncontig_heap */
+        alloc_data.flags = 0;
+
+        if (do_ioctl(b, b->ion_fd, ION_IOC_ALLOC, &alloc_data) < 0) return -2;
+        buf->ion_handle = alloc_data.handle;
+
+        /* 2. Export DMA-BUF file descriptor */
+        struct ion_fd_data fd_data;
+        memset(&fd_data, 0, sizeof(fd_data));
+        fd_data.handle = buf->ion_handle;
+        if (do_ioctl(b, b->ion_fd, ION_IOC_SHARE, &fd_data) < 0) return -3;
+        buf->dma_buf_fd = fd_data.fd;
+
+        struct ion_handle_data hdata;
+        hdata.handle = buf->ion_handle;
+        do_ioctl(b, b->ion_fd, ION_IOC_FREE, &hdata);
+        buf->ion_handle = 0;
+
+        /* 3. Optional CPU mapping for software / Pixman rendering */
+        if (map_cpu && buf->dma_buf_fd >= 0) {
+            buf->cpu_mmap_ptr = mmap(NULL, b->config.buffer_size,
+                                     PROT_READ | PROT_WRITE, MAP_SHARED,
+                                     buf->dma_buf_fd, 0);
+            if (buf->cpu_mmap_ptr == MAP_FAILED) {
+                buf->cpu_mmap_ptr = NULL;
+                return -4;
+            }
+        }
+    }
+
+    b->active_idx = 0;
+    return 0;
+}
+
+int decon_backend_setup_swapchain_egl(struct decon_backend *b)
+{
+    if (!b || !b->egl_display || !b->egl_context) return -1;
+
+    for (int i = 0; i < 2; i++) {
+        struct decon_swapchain_buffer *buf = &b->buffers[i];
+        if (buf->dma_buf_fd < 0) return -2;
+
+        /* 1. Import DMA-BUF as EGLImageKHR */
+        int32_t img_attribs[] = {
+            EGL_WIDTH, (int32_t)b->config.width,
+            EGL_HEIGHT, (int32_t)b->config.height,
+            EGL_LINUX_DRM_FOURCC_EXT, (int32_t)DRM_FORMAT_ABGR8888,
+            EGL_DMA_BUF_PLANE0_FD_EXT, (int32_t)buf->dma_buf_fd,
+            EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+            EGL_DMA_BUF_PLANE0_PITCH_EXT, (int32_t)b->config.stride,
+            EGL_NONE
+        };
+        buf->egl_image = b->eglCreateImageKHR(b->egl_display, EGL_NO_CONTEXT,
+                                              EGL_LINUX_DMA_BUF_EXT, NULL, img_attribs);
+        if (!buf->egl_image) return -3;
+
+        /* 2. Bind EGLImage to GL Texture */
+        b->glGenTextures(1, &buf->gl_texture);
+        b->glBindTexture(GL_TEXTURE_2D, buf->gl_texture);
+        b->glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        b->glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        b->glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, buf->egl_image);
+
+        /* 3. Create Framebuffer Object (FBO) */
+        b->glGenFramebuffers(1, &buf->gl_fbo);
+        b->glBindFramebuffer(GL_FRAMEBUFFER, buf->gl_fbo);
+        b->glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, buf->gl_texture, 0);
+
+        if (b->glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+            return -4;
+        }
+    }
+    return 0;
+}
+
+int decon_backend_setup_swapchain(struct decon_backend *b)
+{
+    int ret = decon_backend_setup_swapchain_ion(b, 0);
+    if (ret < 0) return ret;
+    return decon_backend_setup_swapchain_egl(b);
+}
+
+int decon_backend_begin_frame(struct decon_backend *b, uint32_t *active_fbo)
+{
+    if (!b) return -1;
+    struct decon_swapchain_buffer *buf = &b->buffers[b->active_idx];
+    if (b->glBindFramebuffer) b->glBindFramebuffer(GL_FRAMEBUFFER, buf->gl_fbo);
+    if (b->glViewport) b->glViewport(0, 0, b->config.width, b->config.height);
+    if (active_fbo) *active_fbo = buf->gl_fbo;
+    return 0;
+}
+
+int decon_backend_present(struct decon_backend *b, int *out_retire_fence)
+{
+    if (!b) return -1;
+    struct decon_swapchain_buffer *buf = &b->buffers[b->active_idx];
+
+    /* 1. Flush GPU rendering if active */
+    if (b->glFinish) b->glFinish();
+
+    /* 2. Populate 1040-byte S3CFB_WIN_CONFIG structure */
+    struct decon_win_config_data win_data;
+    memset(&win_data, 0, sizeof(win_data));
+    win_data.fence = -1;
+
+    for (int i = 0; i < 5; i++) {
+        win_data.config[i].state = 0; /* DECON_WIN_STATE_DISABLED */
+        win_data.config[i].fd_idma[0] = -1;
+        win_data.config[i].fd_idma[1] = -1;
+        win_data.config[i].fd_idma[2] = -1;
+        win_data.config[i].fence_fd = -1;
+        win_data.config[i].rel_fence = -1;
+    }
+
+    /* Window 3: Primary scanout window (IDMA channel 0 routing, FIND-021) */
+    uint32_t w = b->config.window_index;
+    win_data.config[w].state = 2;        /* DECON_WIN_STATE_BUFFER */
+    win_data.config[w].fd_idma[0] = buf->dma_buf_fd;
+    win_data.config[w].fd_idma[1] = -1;
+    win_data.config[w].fd_idma[2] = -1;
+    win_data.config[w].fence_fd = -1;
+    win_data.config[w].plane_alpha = 255;
+    win_data.config[w].blending = 0;
+    win_data.config[w].idma_type = 0;    /* IDMA channel 0 */
+    win_data.config[w].format = 2;       /* DECON_PIXEL_FORMAT_RGBA_8888 */
+    win_data.config[w].src_x = 0;
+    win_data.config[w].src_y = 0;
+    win_data.config[w].src_w = b->config.width;
+    win_data.config[w].src_h = b->config.height;
+    win_data.config[w].dst_x = 0;
+    win_data.config[w].dst_y = 0;
+    win_data.config[w].dst_w = b->config.width;
+    win_data.config[w].dst_h = b->config.height;
+
+    /* 3. Issue DECON presentation ioctl */
+    int ret = do_ioctl(b, b->fb_fd, S3CFB_WIN_CONFIG_IOCTL, &win_data);
+    if (ret < 0) return ret;
+
+    /* Close all release fences returned by DECON to prevent FD leaks (FIND-037) */
+    for (int i = 0; i < 5; i++) {
+        if (win_data.config[i].rel_fence >= 0) {
+            close(win_data.config[i].rel_fence);
+            win_data.config[i].rel_fence = -1;
+        }
+    }
+
+    b->last_retire_fence = win_data.fence;
+    if (out_retire_fence) *out_retire_fence = win_data.fence;
+
+    return 0;
+}
+
+int decon_backend_wait_vsync(struct decon_backend *b, int timeout_ms)
+{
+    if (!b) return -1;
+    if (b->last_retire_fence >= 0) {
+        struct pollfd pfd;
+        pfd.fd = b->last_retire_fence;
+        pfd.events = POLLIN;
+        pfd.revents = 0;
+
+        int ret = poll(&pfd, 1, timeout_ms > 0 ? timeout_ms : 1000);
+        close(b->last_retire_fence);
+        b->last_retire_fence = -1;
+
+        if (ret <= 0) return -2; /* Timeout or error */
+    }
+
+    /* Swap ping-pong buffer index */
+    b->active_idx ^= 1;
+    b->total_frames++;
+    return 0;
+}
+
+void decon_backend_teardown(struct decon_backend *b)
+{
+    if (!b) return;
+
+    if (b->last_retire_fence >= 0) {
+        close(b->last_retire_fence);
+        b->last_retire_fence = -1;
+    }
+
+    for (int i = 0; i < 2; i++) {
+        struct decon_swapchain_buffer *buf = &b->buffers[i];
+        if (buf->cpu_mmap_ptr && buf->cpu_mmap_ptr != MAP_FAILED) {
+            munmap(buf->cpu_mmap_ptr, b->config.buffer_size);
+            buf->cpu_mmap_ptr = NULL;
+        }
+        if (buf->egl_image && b->eglDestroyImageKHR) {
+            b->eglDestroyImageKHR(b->egl_display, buf->egl_image);
+            buf->egl_image = NULL;
+        }
+        if (buf->dma_buf_fd >= 0) {
+            close(buf->dma_buf_fd);
+            buf->dma_buf_fd = -1;
+        }
+        if (buf->ion_handle > 0) {
+            struct ion_handle_data free_data;
+            memset(&free_data, 0, sizeof(free_data));
+            free_data.handle = buf->ion_handle;
+            do_ioctl(b, b->ion_fd, ION_IOC_FREE, &free_data);
+            buf->ion_handle = 0;
+        }
+    }
+
+    if (b->egl_display) {
+        b->eglMakeCurrent(b->egl_display, NULL, NULL, NULL);
+        if (b->egl_surface) b->eglDestroySurface(b->egl_display, b->egl_surface);
+        if (b->egl_context) b->eglDestroyContext(b->egl_display, b->egl_context);
+        b->eglTerminate(b->egl_display);
+    }
+
+    if (b->fb_fd >= 0) close(b->fb_fd);
+    if (b->ion_fd >= 0) close(b->ion_fd);
+    free(b);
+}
diff --git a/libweston/backend-decon/decon_backend.h b/libweston/backend-decon/decon_backend.h
new file mode 100644
index 0000000..00cf73a
--- /dev/null
+++ b/libweston/backend-decon/decon_backend.h
@@ -0,0 +1,190 @@
+/*
+ * Direct-DECON Presentation Engine & Wayland Compositor Backend
+ * Target: Samsung Galaxy A30 (SM-A305F) / Exynos 7904 / Mali-G71 MP2
+ *
+ * Implements direct hardware-accelerated presentation to Samsung DECON Window 3
+ * using a double-buffered ION DMA-BUF swapchain and hardware retire fence VSYNC.
+ */
+
+#ifndef DECON_BACKEND_H
+#define DECON_BACKEND_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef unsigned long  size_t;
+typedef long           ssize_t;
+typedef unsigned char  uint8_t;
+typedef unsigned short uint16_t;
+typedef unsigned int   uint32_t;
+typedef unsigned long  uint64_t;
+typedef signed int     int32_t;
+typedef signed long    int64_t;
+typedef signed long    intptr_t;
+typedef unsigned long  uintptr_t;
+
+#ifndef NULL
+#define NULL ((void*)0)
+#endif
+
+#define DECON_DEFAULT_WIDTH        1080
+#define DECON_DEFAULT_HEIGHT       2340
+#define DECON_DEFAULT_STRIDE       4320
+#define DECON_DEFAULT_BPP          32
+#define DECON_DEFAULT_BUFFER_SIZE  10240000 /* 1080 * 2340 * 4 = 10,108,800 bytes, aligned to 10.24 MB */
+#define DECON_PRIMARY_WINDOW       3        /* Exynos 7904 DECON-0 IDMA channel 0 routing (FIND-021) */
+
+#define S3CFB_WIN_CONFIG_IOCTL     0x441046d1 /* _IOW(0x46, 209, 1040 bytes) (FIND-013, FIND-020) */
+
+/* ION Definitions */
+#define ION_IOC_MAGIC 'I'
+#define ION_IOC_ALLOC 0xc0204900
+#define ION_IOC_FREE  0xc0044901
+#define ION_IOC_SHARE 0xc0084904
+
+struct ion_allocation_data {
+    size_t len;
+    size_t align;
+    unsigned int heap_id_mask;
+    unsigned int flags;
+    int handle;
+    int _pad;
+};
+
+struct ion_fd_data {
+    int handle;
+    int fd;
+};
+
+struct ion_handle_data {
+    int handle;
+};
+
+/* -------------------------------------------------------------------------
+ * Exact 1040-Byte S3CFB_WIN_CONFIG Structure Layout (FIND-020)
+ * ------------------------------------------------------------------------- */
+
+struct decon_win_config {
+    int32_t  state;             /* Offset 0x00 (0)  : DECON_WIN_STATE_BUFFER = 2, DISABLED = 0 */
+    int32_t  reserved0;         /* Offset 0x04 (4)  : 0 */
+    int32_t  fd_idma[3];        /* Offset 0x08 (8)  : [0]=DMA-BUF fd, [1]=-1, [2]=-1 */
+    int32_t  fence_fd;          /* Offset 0x14 (20) : Acquire fence (in-fence) fd, -1 if pre-synced */
+    int32_t  rel_fence;         /* Offset 0x18 (24) : [OUT] Release fence fd created by DECON driver */
+    uint32_t plane_alpha;       /* Offset 0x1C (28) : 0-255 (255 = opaque) */
+    uint32_t blending;          /* Offset 0x20 (32) : DECON_BLENDING_NONE = 0 */
+    uint32_t idma_type;         /* Offset 0x24 (36) : 0 (Primary IDMA channel) */
+    uint32_t format;            /* Offset 0x28 (40) : DECON_PIXEL_FORMAT_RGBA_8888 = 2 */
+    uint8_t  padding0[100];     /* Offset 0x2C (44) .. 0x8F (143): 100 bytes reserved */
+    int32_t  src_x;             /* Offset 0x90 (144): source X */
+    int32_t  src_y;             /* Offset 0x94 (148): source Y */
+    uint8_t  padding_src[8];    /* Offset 0x98 (152) .. 0x9F (159): 8 bytes */
+    uint32_t src_w;             /* Offset 0xA0 (160): source width */
+    uint32_t src_h;             /* Offset 0xA4 (164): source height */
+    int32_t  dst_x;             /* Offset 0xA8 (168): destination X */
+    int32_t  dst_y;             /* Offset 0xAC (172): destination Y */
+    uint32_t dst_w;             /* Offset 0xB0 (176): destination width */
+    uint32_t dst_h;             /* Offset 0xB4 (180): destination height */
+    uint32_t extra0;            /* Offset 0xB8 (184): 0 */
+    uint32_t extra1;            /* Offset 0xBC (188): 0 */
+    uint8_t  padding1[8];       /* Offset 0xC0 (192) .. 0xC7 (199): 8 bytes padding (Total: 200 bytes) */
+};
+
+_Static_assert(sizeof(struct decon_win_config) == 200, "decon_win_config must be 200 bytes");
+
+struct decon_win_config_data {
+    int32_t                 fence;       /* Offset 0x000 (0)  : [OUT] Retire fence fd */
+    int32_t                 reserved;    /* Offset 0x004 (4)  : 0 */
+    struct decon_win_config config[5];   /* Offset 0x008 (8)  : 5 windows * 200 bytes = 1000 bytes */
+    uint8_t                 reserved2[32];/* Offset 0x3F0 (1008): 32 bytes tail padding -> Total 1040 bytes */
+};
+
+_Static_assert(sizeof(struct decon_win_config_data) == 1040, "decon_win_config_data must be 1040 bytes");
+
+struct decon_backend_config {
+    uint32_t width;
+    uint32_t height;
+    uint32_t stride;
+    uint32_t buffer_size;
+    uint32_t window_index;
+    const char *fb_node;
+    const char *ion_node;
+    const char *mali_node;
+};
+
+struct decon_swapchain_buffer {
+    int ion_handle;
+    int dma_buf_fd;
+    void *egl_image;       /* EGLImageKHR */
+    uint32_t gl_texture;   /* GLuint */
+    uint32_t gl_fbo;       /* GLuint */
+    void *cpu_mmap_ptr;    /* Optional CPU mapping */
+};
+
+struct decon_backend {
+    struct decon_backend_config config;
+    int fb_fd;
+    int ion_fd;
+
+    /* EGL / GLES handles */
+    void *libgles_handle;
+    void *egl_display;
+    void *egl_context;
+    void *egl_surface;
+
+    /* Ping-pong swapchain (2 buffers) */
+    struct decon_swapchain_buffer buffers[2];
+    uint32_t active_idx;
+    uint64_t total_frames;
+    int last_retire_fence;
+
+    /* Function pointers resolved from libGLES_mali */
+    void *(*eglGetDisplay)(void *native_display);
+    uint32_t (*eglInitialize)(void *dpy, int32_t *major, int32_t *minor);
+    uint32_t (*eglChooseConfig)(void *dpy, const int32_t *attrib_list, void **configs, int32_t config_size, int32_t *num_config);
+    void *(*eglCreatePbufferSurface)(void *dpy, void *config, const int32_t *attrib_list);
+    void *(*eglCreateContext)(void *dpy, void *config, void *share_context, const int32_t *attrib_list);
+    uint32_t (*eglMakeCurrent)(void *dpy, void *draw, void *read, void *ctx);
+    void *(*eglCreateImageKHR)(void *dpy, void *ctx, uint32_t target, void *buffer, const int32_t *attrib_list);
+    uint32_t (*eglDestroyImageKHR)(void *dpy, void *image);
+    uint32_t (*eglDestroySurface)(void *dpy, void *surface);
+    uint32_t (*eglDestroyContext)(void *dpy, void *ctx);
+    uint32_t (*eglTerminate)(void *dpy);
+    int32_t (*eglGetError)(void);
+
+    /* GL Function pointers */
+    void (*glGenTextures)(int32_t n, uint32_t *textures);
+    void (*glBindTexture)(uint32_t target, uint32_t texture);
+    void (*glTexParameteri)(uint32_t target, uint32_t pname, int32_t param);
+    void (*glGenFramebuffers)(int32_t n, uint32_t *framebuffers);
+    void (*glBindFramebuffer)(uint32_t target, uint32_t framebuffer);
+    void (*glFramebufferTexture2D)(uint32_t target, uint32_t attachment, uint32_t textarget, uint32_t texture, int32_t level);
+    uint32_t (*glCheckFramebufferStatus)(uint32_t target);
+    void (*glViewport)(int32_t x, int32_t y, int32_t width, int32_t height);
+    void (*glClearColor)(float red, float green, float blue, float alpha);
+    void (*glClear)(uint32_t mask);
+    void (*glFinish)(void);
+    void (*glEGLImageTargetTexture2DOES)(uint32_t target, void *image);
+    /* Custom ioctl handler (NULL defaults to libc ioctl) */
+    int (*ioctl_fn)(int fd, unsigned long request, void *arg);
+};
+
+/* -------------------------------------------------------------------------
+ * Backend Operations
+ * ------------------------------------------------------------------------- */
+
+struct decon_backend *decon_backend_init(const struct decon_backend_config *cfg);
+int decon_backend_setup_egl(struct decon_backend *b, void *dl_handle);
+int decon_backend_setup_swapchain_ion(struct decon_backend *b, int map_cpu);
+int decon_backend_setup_swapchain_egl(struct decon_backend *b);
+int decon_backend_setup_swapchain(struct decon_backend *b);
+int decon_backend_begin_frame(struct decon_backend *b, uint32_t *active_fbo);
+int decon_backend_present(struct decon_backend *b, int *out_retire_fence);
+int decon_backend_wait_vsync(struct decon_backend *b, int timeout_ms);
+void decon_backend_teardown(struct decon_backend *b);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* DECON_BACKEND_H */
