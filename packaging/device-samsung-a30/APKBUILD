pkgname=device-samsung-a30
pkgver=1.0.6
pkgrel=0
pkgdesc="postmarketOS device configuration package for Samsung Galaxy A30 (SM-A305F)"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="postmarketos-base
	eudev
	seatd
	pixman
	wayland
	libxkbcommon
	libinput"
source="deviceinfo
	initfs-hook.sh
	weston.ini
	weston.initd
	99-mali-decon.rules
	driver-payload.tar.gz
	boot.img
	kernel.release
	kernel-patched.bin"
subpackages=""
options="!check !tracedeps !strip"

sha512sums="
