"

package() {
	# Install deviceinfo (both in /usr/share/deviceinfo and /etc for mkinitfs)
	install -Dm644 "$srcdir"/deviceinfo \
		"$pkgdir"/usr/share/deviceinfo/deviceinfo
	install -d "$pkgdir"/etc
	ln -sf /usr/share/deviceinfo/deviceinfo "$pkgdir"/etc/deviceinfo

	# Install initfs hook
	install -Dm755 "$srcdir"/initfs-hook.sh \
		"$pkgdir"/etc/postmarketos-mkinitfs/hooks/00-samsung-a30.sh

	# Install Weston configuration
	install -Dm644 "$srcdir"/weston.ini \
		"$pkgdir"/etc/xdg/weston/weston.ini

	# Install OpenRC service and enable it in default runlevel
	install -Dm755 "$srcdir"/weston.initd \
		"$pkgdir"/etc/init.d/weston
	mkdir -p "$pkgdir"/etc/runlevels/default
	ln -sf /etc/init.d/weston "$pkgdir"/etc/runlevels/default/weston
	ln -sf /etc/init.d/seatd "$pkgdir"/etc/runlevels/default/seatd

	# Install udev hardware rules
	install -Dm644 "$srcdir"/99-mali-decon.rules \
		"$pkgdir"/usr/lib/udev/rules.d/99-mali-decon.rules

	# Kernel metadata for postmarketos-mkinitfs
	install -Dm644 "$srcdir"/kernel.release \
		"$pkgdir"/usr/share/kernel/samsung-a30/kernel.release
	install -Dm644 "$srcdir"/kernel-patched.bin \
		"$pkgdir"/boot/vmlinuz
	install -Dm644 "$srcdir"/kernel-patched.bin \
		"$pkgdir"/boot/vmlinuz-samsung-a30
	mkdir -p "$pkgdir"/lib/modules/4.4.302-samsung-a30
	touch "$pkgdir"/lib/modules/4.4.302-samsung-a30/modules.dep

	# Unpack prebuilt driver payload (libhybris, weston-decon, gl-renderer, libexec_weston, shells)
	mkdir -p "$pkgdir"/usr
	tar -zxf "$srcdir"/driver-payload.tar.gz -C "$pkgdir"

	# Install prebuilt boot.img
	install -Dm644 "$srcdir"/boot.img \
		"$pkgdir"/boot/boot.img
}
